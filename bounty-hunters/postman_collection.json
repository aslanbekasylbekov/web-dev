{
  "info": {
    "name": "Space Bounty Hunters API",
    "description": "Midterm practical: wanted criminals and the bounty hunting journal. Run the requests top to bottom (or Run collection): the POST saves the new id into {{huntId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Wanted Criminals",
      "item": [
        {
          "name": "List all criminals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"At least 5 criminals\", () => pm.expect(pm.response.json().length).to.be.at.least(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter: min_reward + armed + sort=-reward (example from task)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/criminals/?min_reward=5000&armed=true&sort=-reward",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "criminals",
                ""
              ],
              "query": [
                {
                  "key": "min_reward",
                  "value": "5000"
                },
                {
                  "key": "armed",
                  "value": "true"
                },
                {
                  "key": "sort",
                  "value": "-reward"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"All armed with reward >= 5000\", () => d.forEach(c => { pm.expect(c.armed).to.eql(true); pm.expect(c.reward).to.be.at.least(5000); }));",
                  "pm.test(\"Sorted by reward descending\", () => { for (let i = 1; i < d.length; i++) pm.expect(d[i-1].reward).to.be.at.least(d[i].reward); });"
                ]
              }
            }
          ]
        },
