        {
          "name": "Create hunt log (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hunts/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hunts",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const h = pm.response.json();",
                  "pm.test(\"created_at generated by server\", () => pm.expect(h.created_at).to.be.a(\"string\"));",
                  "pm.test(\"Fields saved\", () => { pm.expect(h.criminal_id).to.eql(3); pm.expect(h.success).to.eql(false); });",
                  "pm.collectionVariables.set(\"huntId\", h.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the created hunt log",
          "request": {
            "method": "GET",
